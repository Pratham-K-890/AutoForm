# ─── JWT ──────────────────────────────────────────────────────────────────────
JWT_SECRET=change-this-to-a-long-random-string-in-production

# ─── Token encryption (Fernet key) ────────────────────────────────────────────
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# ─── Google OAuth ─────────────────────────────────────────────────────────────
# Create a project at console.cloud.google.com, enable "People API", add OAuth
# consent screen, then create OAuth 2.0 credentials (Web Application).
# Authorised redirect URI: http://localhost:8000/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/google/callback

# ─── LLM APIs ─────────────────────────────────────────────────────────────────
GROQ_API_KEY=
GEMINI_API_KEY=

# ─── App ──────────────────────────────────────────────────────────────────────
APP_URL=http://localhost:8000
DATABASE_URL=sqlite:///./autoform.db
